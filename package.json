    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.1",
