# Frontend (public, safe to expose: protected by RLS)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge functions (set with `supabase secrets set`, never in the frontend)
# SUPABASE_SERVICE_ROLE_KEY is injected by Supabase automatically.
ANTHROPIC_API_KEY=
LUGU_AI_MODEL=claude-sonnet-5-5
